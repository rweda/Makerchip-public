.mc-browser(style="display:flex; flex-direction:column; width:100%; height:100%;")
  .mc-browser-toolbar(style="display:flex; align-items:center; gap:4px; padding:4px 6px; flex:0 0 auto;")
    button.mc-browser-back(title="Back" style="border-radius:4px; padding:4px 8px; cursor:default; opacity:0.4;")
      i.fa-solid.fa-arrow-left
    button.mc-browser-forward(title="Forward" style="border-radius:4px; padding:4px 8px; cursor:default; opacity:0.4;")
      i.fa-solid.fa-arrow-right
    input.mc-browser-url(type="text" placeholder="Enter a URL and press Enter" style="flex:1 1 auto; border-radius:4px; padding:5px 8px; font-family:inherit;")
    button.mc-browser-go(title="Go" style="border-radius:4px; padding:4px 10px; cursor:pointer;") Go
    .mc-browser-fav-wrap(style="position:relative;")
      button.mc-browser-star(title="Favorites" style="border-radius:4px; padding:4px 8px; cursor:pointer;")
        i.fa-solid.fa-star
      .mc-browser-favorites(style="display:none; position:absolute; right:0; top:100%; margin-top:2px; min-width:160px; border-radius:4px; z-index:10000;")
    button.mc-browser-popout(title="Open in its own pane" style="border-radius:4px; padding:4px 8px; cursor:pointer;")
      i.fa-solid.fa-arrow-turn-up
    button.mc-browser-close(title="Done navigating; close address bar" style="border-radius:4px; padding:4px 8px; cursor:pointer;")
      i.fa-solid.fa-check
  .mc-browser-content(style="position:relative; flex:1 1 auto; min-height:0;")
    .mc-iframe-slot.mc-browser-slot(style="position:absolute; inset:0;")
    .mc-browser-home(style="position:absolute; inset:0; display:none; overflow:auto;")
      .mc-browser-home-inner
        .mc-browser-home-title Makerchip Browser
        .mc-browser-home-sub Enter a URL above, or pick a favorite:
        .mc-browser-home-links
